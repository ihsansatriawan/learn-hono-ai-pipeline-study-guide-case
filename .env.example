# API
# hono-prisma-bullmq and feedback-pipeline-api use 3000
PORT=3100

# PostgreSQL — the host port is deliberately different from hono-prisma-bullmq
# (55432) and feedback-pipeline-api (55433), so all three can run side by side.
DATABASE_URL="postgresql://studyguide:studyguide@localhost:55434/studyguide"

# Redis — the host port is deliberately different from hono-prisma-bullmq (6380)
# and feedback-pipeline-api (6381).
REDIS_HOST=localhost
REDIS_PORT=6382

# OpenAI-compatible model provider
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
MODEL_ID="openai/gpt-5.6-luna"
