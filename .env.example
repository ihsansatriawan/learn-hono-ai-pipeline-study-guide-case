# API
# hono-prisma-bullmq dan feedback-pipeline-api memakai 3000
PORT=3100

# PostgreSQL — port host sengaja berbeda dari hono-prisma-bullmq (55432)
# dan feedback-pipeline-api (55433), supaya ketiganya bisa jalan bersamaan.
DATABASE_URL="postgresql://studyguide:studyguide@localhost:55434/studyguide"

# Redis — port host sengaja berbeda dari hono-prisma-bullmq (6380) dan
# feedback-pipeline-api (6381).
REDIS_HOST=localhost
REDIS_PORT=6382

# Penyedia model OpenAI-compatible
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
MODEL_ID="openai/gpt-5.6-luna"
