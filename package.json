    "@prisma/orm-postgres": "8.0.0-rc.9",
    "bullmq": "^6.3.4",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "ioredis": "^6.0.0",
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.3.0",
    "@types/node": "^26.1.1",
    "prisma": "8.0.0-rc.10",
    "tsx": "^4.23.0",
